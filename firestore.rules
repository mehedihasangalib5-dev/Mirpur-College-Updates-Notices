rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // config/admins = { emails: ["owner@gmail.com", "admin@gmail.com"], editors: ["editor@gmail.com"] }
    //   (lowercase; emails[0] = Owner, baki emails = Admin, editors = shudhu post create/edit)
    // (purono setup-er jonno { ids: [uid...] }-o ekhono kaj kore)
    function adm() { return get(/databases/$(db)/documents/config/admins).data; }
    function emailIn(list) {
      return request.auth.token.email_verified == true
        && request.auth.token.email.lower() in list;
    }
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(db)/documents/config/admins)
        && (request.auth.uid in adm().get('ids', []) || emailIn(adm().get('emails', [])));
    }
    // Editor: post create/edit pare, kintu delete / message / backup / role pare na
    function isEditor() {
      return request.auth != null
        && exists(/databases/$(db)/documents/config/admins)
        && emailIn(adm().get('editors', []));
    }
    function isStaff() { return isAdmin() || isEditor(); }

    match /posts/{id} {
      allow read: if true;              // public site
      allow create: if isStaff();       // Admin + Editor
      allow delete: if isAdmin();       // shudhu Admin/Owner
      // Admin/Editor jekono field update korte pare; visitor shudhu "views" ekbare +1
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1);
    }
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','subject','message','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000;
      allow read, delete: if isAdmin();   // only admins read contact messages
      // Admin panel: Read/Unread, Star, Archive flag
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','star','arch'])
        && request.resource.data.get('read', false) is bool
        && request.resource.data.get('star', false) is bool
        && request.resource.data.get('arch', false) is bool;
    }
    // logs/{id} = Admin panel Activity Log (append-only; shudhu Admin pore, Admin/Editor likhte pare)
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['ts','by','email','act','id','title'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.ts is number
        && request.resource.data.act is string && request.resource.data.act.size() <= 30
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.id is string && request.resource.data.id.size() <= 80
        && request.resource.data.title is string && request.resource.data.title.size() <= 150;
    }
    // users/{uid} = student profile (login-er por Year/Department ekhan theke ashe)
    // shudhu nijer doc-ta nijei read/write korte pabe; Admin read korte pare
    // Year/Department list index.html + admin.html-er sathe mil rakhte hobe
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true     // email code diye verify na hole profile save hobe na
        && request.resource.data.keys().hasOnly(['uid','name','email','year','dept','photo','updated'])
        && request.resource.data.keys().hasAll(['uid','name','year','dept'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.year in ['HSC 1st Year', 'HSC 2nd Year']
        && request.resource.data.dept in ['Science', 'Arts', 'Commerce']
        && request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 100000
        && request.resource.data.get('updated', 0) is number;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // emailCodes/{uid} = verification code hash (shudhu server/Admin SDK likhe-pore; client kokhono na)
    match /emailCodes/{id} { allow read, write: if false; }
    // pushTokens/{uid} = student-er device token (shudhu server likhe-pore)
    match /pushTokens/{id} { allow read, write: if false; }
    // notifLogs = Admin panel-e pathano notification-er history (shudhu server likhe-pore)
    match /notifLogs/{id} { allow read, write: if false; }
    match /config/admins {
      allow read: if isStaff();           // Admin o Editor nijeder role jante read korte pare
      // shudhu Owner (emails[0] ba purono ids[0]) list bodlate pare
      allow write: if request.auth != null && (
        (resource.data.get('ids', []).size() > 0 && resource.data.ids[0] == request.auth.uid)
        || (resource.data.get('emails', []).size() > 0 && emailIn([resource.data.emails[0]]))
      );
    }
  }
}
